{
  "endOfLine": "lf",
  "useTabs": true,
  "singleQuote": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "plugins": ["prettier-plugin-svelte", "prettier-plugin-tailwindcss"],
  "overrides": [{ "files": "*.svelte", "options": { "parser": "svelte" } }],
  "tailwindStylesheet": "../../docs/demos/shadcn/index.css",
  "tailwindFunctions": ["cn", "cva"]
}
