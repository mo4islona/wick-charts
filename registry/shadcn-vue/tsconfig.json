{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@wick-charts/core": ["../../packages/core/src/index.ts"],
      "@wick-charts/vue": ["../../packages/vue/src/index.ts"],
      "@/components/ui/card": ["./shims/card.d.ts"],
      "@/lib/utils": ["./shims/utils.d.ts"],
      "@/*": ["./*"]
    }
  },
  "include": ["components", "composables", "shims"]
}
