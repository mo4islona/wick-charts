{
  "name": "@wick-charts/svelte",
  "version": "0.8.4",
  "description": "Realtime, animated canvas charts for Svelte: candlestick, line, bar, heatmap, pie and more. Tree-shakeable, zero runtime deps.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo4islona/wick-charts.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://wick-charts.eeff.io/",
  "bugs": "https://github.com/mo4islona/wick-charts/issues",
  "keywords": [
    "charts",
    "charting",
    "canvas",
    "realtime",
    "streaming",
    "animation",
    "candlestick",
    "line-chart",
    "area-chart",
    "bar-chart",
    "heatmap",
    "pie-chart",
    "sparkline",
    "timeseries",
    "svelte",
    "visualization"
  ],
  "type": "module",
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "!src/__tests__",
    "!src/**/*.test.*"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist && node scripts/copy-core.mjs",
    "prepublishOnly": "pnpm -w readme && pnpm build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@wick-charts/core": "workspace:^"
  }
}
