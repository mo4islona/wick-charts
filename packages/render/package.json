{
  "name": "@wick-charts/render",
  "version": "0.9.3",
  "description": "Render Wick Charts to PNG or SVG in Node, with no browser. Includes an MCP server with a render_chart tool.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mo4islona/wick-charts.git",
    "directory": "packages/render"
  },
  "homepage": "https://wick-charts.eeff.io/",
  "bugs": "https://github.com/mo4islona/wick-charts/issues",
  "keywords": [
    "charts",
    "png",
    "svg",
    "server-side-rendering",
    "headless",
    "mcp",
    "candlestick",
    "line-chart"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "wick-charts-render": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "vite build",
    "prepublishOnly": "pnpm -w readme && pnpm build",
    "typecheck:consumer": "tsc -p type-tests && tsc -p type-tests/tsconfig.cjs.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@fontsource/outfit": "^5.3.0",
    "@napi-rs/canvas": "^0.1.100"
  },
  "devDependencies": {
    "@wick-charts/core": "workspace:^"
  }
}
