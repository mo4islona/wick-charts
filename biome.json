{
  "files": {
    "includes": [
      "**",
      "!.claude/worktrees",
      "!test",
      "!node_modules",
      "!**/dist",
      "!docs-dist",
      "!coverage",
      "!docs/data/api-manifest.json"
    ]
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "correctness": {
        "useExhaustiveDependencies": "off"
      },
      "style": {
        "noNonNullAssertion": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off"
      },
      "a11y": {
        "noSvgWithoutTitle": "off",
        "useButtonType": "off",
        "useKeyWithClickEvents": "off",
        "noStaticElementInteractions": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "identifierOrder": "lexicographic",
            "groups": [
              [":NODE:", "react"],
              ":BLANK_LINE:",

              [":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:"],
              ":BLANK_LINE:",

              ["~/**"],
              ":BLANK_LINE:"
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "overrides": [
    {
      "includes": [
        "registry/shadcn/blocks/**",
        "registry/shadcn/hooks/**",
        "registry/shadcn/ui/**",
        "registry/shadcn-vue/components/**",
        "registry/shadcn-vue/composables/**",
        "registry/shadcn-svelte/blocks/**",
        "registry/shadcn-svelte/hooks/**",
        "registry/shadcn-svelte/ui/**"
      ],
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "domains": {
          "react": "none"
        }
      }
    }
  ]
}
