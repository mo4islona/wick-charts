# Cloudflare Pages headers. Vite emits content-hashed asset filenames, so they
# can be cached forever; HTML stays revalidated by Pages' defaults.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# shadcn registry items: public JSON that tools and previews fetch cross-origin.
/r/*
  Access-Control-Allow-Origin: *
