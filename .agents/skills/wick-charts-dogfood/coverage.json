  "quirkClasses": {
    "time-gap": "missing bars inside a regular series",
    "weekend-gap": "market closures (weekends, holidays)",
    "null-inner": "null values inside a series",
    "null-trailing": "a run of nulls at the end (source lag)",
    "zero-as-missing": "the source reports missing data as 0",
    "zero-values": "legit zeros (pie slices, solar at night)",
    "negative-values": "values below zero",
    "zero-crossing": "a series that changes sign",
    "tiny-magnitude": "values ~1e-6 and below",
    "huge-magnitude": "values ~1e12 and above",
    "scale-gap": "layers 10-100x apart",
    "flat-range": "all values (nearly) equal",
    "flat-candle": "O=H=L=C candles",
    "zero-volume": "volume 0",
    "interval-change": "sampling step changes mid-series",
